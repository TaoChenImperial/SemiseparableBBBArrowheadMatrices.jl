\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Log-log performance comparisons between our proposed fast BPS QR algorithm and the HODLR QR implementation from\nobreakspace  {}\citep  {massei2020hm} (with parameters $\ell =4$, $m=5$, $r=2$, $p=3$). Panel (a) illustrates the execution times for the structured QR factorization phase; Panel (b) presents the execution times for the solve phase (applying $Q^\top $ and backward substitution).}}{19}{figure.3}\protected@file@percent }
\newlabel{fig:comparison}{{3}{19}{Log-log performance comparisons between our proposed fast BPS QR algorithm and the HODLR QR implementation from~\citep {massei2020hm} (with parameters $\ell =4$, $m=5$, $r=2$, $p=3$). Panel (a) illustrates the execution times for the structured QR factorization phase; Panel (b) presents the execution times for the solve phase (applying $Q^\top $ and backward substitution)}{figure.3}{}}
