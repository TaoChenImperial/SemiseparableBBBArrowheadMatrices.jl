\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Performance scaling comparison between our proposed structured $O(n)$ BPS solver and LAPACK dense solvers (both Unblocked and Compact WY BLAS-3 implementations). Panel (a) shows the execution times for the QR factorization phase; Panel (b) illustrates the execution times for the solve phase.}}{20}{figure.4}\protected@file@percent }
\newlabel{fig:lapack_compare}{{4}{20}{Performance scaling comparison between our proposed structured $O(n)$ BPS solver and LAPACK dense solvers (both Unblocked and Compact WY BLAS-3 implementations). Panel (a) shows the execution times for the QR factorization phase; Panel (b) illustrates the execution times for the solve phase}{figure.4}{}}
