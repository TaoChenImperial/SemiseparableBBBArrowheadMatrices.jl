\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Log-log plots of execution times versus matrix size $n$ for four parameter sets $(\ell , m, r, p)$, demonstrating optimal linear complexity. (a) Execution time for the structured QR factorization; (b) Execution time for the solve phase (applying $Q^\top $ and backward substitution). The dashed lines have a slope of 1, indicating perfect linear scaling $O(n)$.}}{17}{figure.1}\protected@file@percent }
\newlabel{fig:qr_scaling}{{1}{17}{Log-log plots of execution times versus matrix size $n$ for four parameter sets $(\ell , m, r, p)$, demonstrating optimal linear complexity. (a) Execution time for the structured QR factorization; (b) Execution time for the solve phase (applying $Q^\top $ and backward substitution). The dashed lines have a slope of 1, indicating perfect linear scaling $O(n)$}{figure.1}{}}
